// Cloudflare Workers config. Build command in Cloudflare: cd site && npm ci && npm run build
// Deploy command: npx wrangler deploy. Every push to main redeploys the site.
{
  "name": "elenz",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // a preview address for every version uploaded from a branch (Workers Builds, non-production branches): check a
  // pull request on a phone before it merges. Crons run only on the deployed version, so previews start no jobs.
  "preview_urls": true,
  // keep variables and secrets set in the Cloudflare dashboard (GITHUB_TOKEN) when a code push redeploys
  "keep_vars": true,
  // every 5 minutes, just after each interval's dispatch case is published: triggers the GitHub live data job.
  // every 6 hours at :40: triggers the history job (newly published daily dispatch files). See worker/index.js.
  "triggers": { "crons": ["*/5 * * * *", "40 */6 * * *"] },
  "assets": {
    "directory": "./site/build",
    "binding": "ASSETS",
    // the Worker answers /data/* itself, and adds link-preview tags to the tracker's pages (worker/index.js)
    "run_worker_first": ["/data/*", "/tracker", "/tracker/prices"]
  },
  // Workers KV namespace "elenz-data": the GitHub jobs write tracker.json (ingest/update.py) and hist/* (ingest/history.py) here
  "kv_namespaces": [{ "binding": "DATA", "id": "dd69ad9aae3343c8b3ca5722ddf45548" }]
}
