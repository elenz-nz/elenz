// Cloudflare Workers config. Build command in Cloudflare: cd site && npm ci && npm run build
// Deploy command: npx wrangler deploy. Every push to main redeploys the site.
{
  "name": "elenz",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // the old elenz.elenz.workers.dev address is off (26 Oct 2026): Google had indexed copies of pages there. The site
  // answers only at elenz.co.nz (custom domain, set in the dashboard; www redirects to it).
  "workers_dev": false,
  // preview addresses for branches (Workers Builds builds every non-production branch with `npx wrangler preview`,
  // at https://<branch>-elenz.elenz.workers.dev): check a pull request on a phone before it merges. Previews run no
  // crons, so they start no jobs; see "previews" below. Set explicitly: it would otherwise follow workers_dev (off).
  // Every host but elenz.co.nz is sent X-Robots-Tag: noindex (site/static/_headers, and the Worker for its own pages).
  "preview_urls": true,
  // keep variables and secrets set in the Cloudflare dashboard (GITHUB_TOKEN) when a code push redeploys
  "keep_vars": true,
  // every 5 minutes, just after each interval's dispatch case is published: triggers the GitHub live data job.
  // every 6 hours at :40: triggers the history job (newly published daily dispatch files). See worker/index.js.
  "triggers": { "crons": ["*/5 * * * *", "40 */6 * * *"] },
  "assets": {
    "directory": "./site/build",
    "binding": "ASSETS",
    // an address with no file gets the site's not-found page (site/build/404.html, from src/routes/404) with status
    // 404, instead of an empty reply (blank on phones). SITE-07, 30 Oct 2026.
    "not_found_handling": "404-page",
    // the Worker answers /data/* itself, and adds link-preview tags to the tracker's pages (worker/index.js)
    "run_worker_first": ["/data/*", "/tracker", "/tracker/prices"]
  },
  // Workers KV namespace "elenz-data": the GitHub jobs write tracker.json (ingest/update.py) and hist/* (ingest/history.py) here
  "kv_namespaces": [{ "binding": "DATA", "id": "dd69ad9aae3343c8b3ca5722ddf45548" }],
  // Worker Previews (each branch's preview link, built by `wrangler preview`): the same KV namespace, so a preview shows
  // the live data. Safe because only the scheduled handler writes to KV, and previews run no crons.
  "previews": {
    "kv_namespaces": [{ "binding": "DATA", "id": "dd69ad9aae3343c8b3ca5722ddf45548" }]
  }
}
